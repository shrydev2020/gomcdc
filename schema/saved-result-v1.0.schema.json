{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shrydev2020/gomcdc/schema/saved-result-v1.0.schema.json",
  "title": "gomcdc saved result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "sha256",
    "result"
  ],
  "properties": {
    "format": {
      "const": "gomcdc-saved-result"
    },
    "version": {
      "const": "1.0"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings",
        "report",
        "sources"
      ],
      "properties": {
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "report": {
          "$ref": "report-v2.0.schema.json"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "packagePatterns",
        "packages",
        "coverage",
        "goTestArgs",
        "goFlags",
        "goEnvironment",
        "includeTests",
        "excludes",
        "timeout",
        "strict",
        "failUnder",
        "sourceDigests",
        "moduleConfigDigests"
      ],
      "properties": {
        "workingDirectory": {
          "type": "string"
        },
        "packagePatterns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "goTestArgs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "goFlags": {
          "type": "string"
        },
        "goEnvironment": {
          "type": "object",
          "required": [
            "GOVERSION",
            "GOOS",
            "GOARCH"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "includeTests": {
          "type": "boolean"
        },
        "excludes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string"
        },
        "strict": {
          "type": "boolean"
        },
        "failUnder": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "sourceDigests": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "moduleConfigDigests": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagePath",
        "path",
        "content",
        "sha256"
      ],
      "properties": {
        "packagePath": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": [
            "string",
            "null"
          ],
          "contentEncoding": "base64"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
